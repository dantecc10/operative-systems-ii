[81.557678, "o", "\r               \rDes:1 http://apt.pop-os.org/ubuntu noble-security/universe amd64 inetutils-traceroute amd64 2:2.5-3ubuntu4.2 [42.3 kB]\r\n\u001b[33m\r23% [1 inetutils-traceroute 11.9 kB/42.3 kB 28%]\u001b[0m"]
