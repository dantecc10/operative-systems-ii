[117.248235, "o", "\r\n  \u001b[1mtraceroute\u001b[0m\r\n\r\n  Print the route packets trace to network host.\u001b[0m\r\n  See also: `mtr`.\u001b[0m\r\n  More information: https://manned.org/traceroute.\u001b[0m\r\n\r\n  \u001b[32m- Traceroute to a host:\u001b[0m\r\n"]
[117.248586, "o", "    \u001b[31mtraceroute \u001b[0mexample.com\u001b[0m\u001b[31m\u001b[0m\r\n\r\n  \u001b[32m- Disable IP address and host name mapping:\u001b[0m\r\n    \u001b[31mtraceroute -n \u001b[0mexample.com\u001b[0m\u001b[31m\u001b[0m\r\n\r\n  \u001b[32m- Specify wait time in seconds for response:\u001b[0m\r\n    \u001b[31mtraceroute --wait \u001b[0m0.5\u001b[0m\u001b[31m \u001b[0mexample.com\u001b[0m\u001b[31m\u001b[0m\r\n"]
[117.248797, "o", "\r\n  \u001b[32m- Specify number of queries per hop:\u001b[0m\r\n    \u001b[31mtraceroute --queries \u001b[0m5\u001b[0m\u001b[31m \u001b[0mexample.com\u001b[0m\u001b[31m\u001b[0m\r\n\r\n  \u001b[32m- Specify size in bytes of probing packet:\u001b[0m\r\n"]
[117.248992, "o", "    \u001b[31mtraceroute \u001b[0mexample.com\u001b[0m\u001b[31m \u001b[0m42\u001b[0m\u001b[31m\u001b[0m\r\n\r\n  \u001b[32m- Determine the MTU to the destination:\u001b[0m\r\n    \u001b[31mtraceroute --mtu \u001b[0mexample.com\u001b[0m\u001b[31m\u001b[0m\r\n\r\n  \u001b[32m- Use ICMP instead of UDP for tracerouting:\u001b[0m\r\n    \u001b[31mtraceroute --icmp \u001b[0mexample.com\u001b[0m\u001b[31m\u001b[0m\r\n\r\n"]
