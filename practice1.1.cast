[1.906126, "o", "\u001b[1;5H\u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m!\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[1;31H \u001b[1;45HO\u001b[53G9\r\u001b[2d<\u001b[9G \u001b[2;39H \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32mt\u001b[39m\u001b(B\u001b[m \u001b[37m;\u001b[53GU\u001b[75G\u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m2\u001b[39m\u001b(B\u001b[m \u001b[32m \r\u001b[3d\u001b[37mN\u001b[3;25H\u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m>\u001b[3;49H \u001b[57GB\u001b[4;27H\u001b[37m@\u001b[4;57HP\u001b[5;15H\u001b[32m \u001b[5;29Hv\u001b[5;51Ht\u001b[77G9\r\u001b[6d \u001b[6;29H\u001b[37mv\u001b[6;41H\u001b[32m \u001b[6;51H\u001b[37mo\u001b[6;61H\u001b[32me\u001b[77G\u001b[37m@\u001b[7;25H\u001b[32m[\u001b[7;53H \u001b[61G\u001b[37mK\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[8;25H\u001b[37m\\\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[8;47H \u001b[9;7Hd\u001b[9;37H7\u001b[9;71H2\u001b[10;7H\u001b[37mq\u001b[39m\u001b(B\u001b[m \u001b[32mq\u001b[10;37H"]
