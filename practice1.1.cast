[8.342709, "o", "\u001b[1;3H\u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m9\u001b[1;17Hp\u001b[1;35H\u001b[37m3\u001b[39m\u001b(B\u001b[m \u001b[32m7\u001b[1;59H \u001b[73G \u001b[2;7H\u001b[37m7\u001b[15G\u001b[32m)\u001b[39m\u001b(B\u001b[m \u001b[37m=\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32mu\u001b[2;37H\u001b[37m(\u001b[3;15H-\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[37m,\u001b[39m\u001b(B\u001b[m \u001b[32mP\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m+\u001b[39m\u001b(B\u001b[m \u001b[32mB\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[3;55H \u001b[4;9Ha\u001b[4;27Hc\u001b[39m\u001b(B\u001b[m \u001b[32mv\u001b[4;41H&\u001b[5;9H\u001b[37mD\u001b[5;27Hk\u001b[39m\u001b(B\u001b[m \u001b[37m$\u001b[5;41HW\u001b[5;65H\u001b[32m:\u001b[6d\b\u001b[37mH\u001b[7;5H\u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[8;35H \u001b[43Gq\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32mN\u001b[39m\u001b(B\u001b[m \u001b[32mE\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[8;67H4\u001b[39m\u001b(B\u001b[m \u001b[32mL\u001b[9;19H \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32mD\u001b[39m\u001b(B\u001b[m \u001b[32mr\u001b[9;39H$\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[37mB\u001b[39m\u001b(B\u001b[m \u001b[32m]\u001b[39m\u001b(B\u001b[m \u001b[37m(\u001b[9;57H\u001b[32m \u001b[9;67H\u001b[37mW\u001b[39m\u001b(B\u001b[m \u001b[37mh\u001b[10;13H\u001b[32m \u001b[10;25H\u001b[37m.\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[32mU\u001b[39m\u001b(B\u001b[m \u001b[32mc\u001b[39m\u001b(B\u001b[m \u001b[32mT\u001b[39m\u001b(B\u001b[m \u001b[32m \u001b[39m\u001b(B\u001b[m \u001b[37m,\u001b[10;49H\u00