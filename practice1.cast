[375.858654, "o", "\r\n\u001b[?2004l\r"]
[378.775331, "o", "\r\n  \u001b[1mhostname\u001b[0m\r\n\r\n  Muestra o establece el nombre del host del sistema.\u001b[0m\r\n  Más información: https://www.gnu.org/software/inetutils/manual/inetutils.html#hostname-invocation.\u001b[0m\r\n\r\n  \u001b[32m- Muestra el nombre actual del host:\u001b[0m\r\n"]
[378.775401, "o", "    \u001b[31mhostname\u001b[0m\r\n"]
[378.775435, "o", "\r\n  \u001b[32m- Muestra la dirección de red correspondiente al nombre del host:\u001b[0m\r\n    \u001b[31mhostname --ip-address\u001b[0m\r\n\r\n  \u001b[32m- Muestra el FQDN (nombre de dominio completamente calificado):\u001b[0m\r\n    \u001b[31mhostname --fqdn\u001b[0m\r\n"]
[378.77548, "o", "\r\n  \u001b[32m- Establece el nombre del host:\u001b[0m\r\n    \u001b[31mhostname \u001b[0mnuevo_nombre\u001b[0m\u001b[31m\u001b[0m\r\n\r\n"]
