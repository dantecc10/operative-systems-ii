[91.975083, "o", "\r\n  \u001b[1mifconfig\u001b[0m\r\n\r\n  Configurador de interfaces de red.\u001b[0m\r\n  Más información: https://net-tools.sourceforge.io/man/ifconfig.8.html.\u001b[0m\r\n\r\n  \u001b[32m- Vea la configuración de red de una interfaz:\u001b[0m\r\n"]
[91.975506, "o", "    \u001b[31mifconfig \u001b[0mnombre_de_la_interfaz\u001b[0m\u001b[31m\u001b[0m\r\n\r\n  \u001b[32m- Muestra los detalles de todas las interfaces, incluidas las desactivadas:\u001b[0m\r\n    \u001b[31mifconfig -a\u001b[0m\r\n\r\n  \u001b[32m- Desactiva una interfaz:\u001b[0m\r\n    \u001b[31mifconfig \u001b[0mnombre_de_la_interfaz\u001b[0m\u001b[31m down\u001b[0m\r\n\r\n  \u001b[32m- Habilita una interfaz:\u001b[0m\r\n"]
[91.975759, "o", "    \u001b[31mifconfig \u001b[0mnombre_de_la_interfaz\u001b[0m\u001b[31m up\u001b[0m\r\n\r\n  \u001b[32m- Asigna una dirección IP a una interfaz:\u001b[0m\r\n"]
[91.975851, "o", "    \u001b[31mifconfig \u001b[0mnombre_de_la_interfaz\u001b[0m\u001b[31m \u001b[0mdirección_ip\u001b[0m\u001b[31m\u001b[0m\r\n\r\n"]
